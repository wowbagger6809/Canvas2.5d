proc //abbrev {args} {
 foreach proc $args {
  set cmd {}
  foreach c [split $proc {}] {
	append cmd $c
	if {$cmd eq $proc} {continue}
	set procs [info procs $cmd*]
	lDel procs $proc
	if {[llength $procs ] < 1 } {
		alias $cmd $proc
#		puts "alias $cmd $proc"
	}
  }
 }
}




